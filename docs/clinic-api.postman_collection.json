          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"encounter\": \"{{encounter}}\"\n}" },
            "url": { "raw": "{{api}}.encounters.submit_encounter", "host": ["{{api}}.encounters.submit_encounter"] },
            "description": "After submit the encounter is immutable; update_encounter returns CONFLICT."
          }
        }
      ]
    },
