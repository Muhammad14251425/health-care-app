    {
      "name": "7. Payments",
      "item": [
        {
          "name": "Record PARTIAL payment (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().message;",
                  "if (b.success) {",
                  "  pm.test('outstanding reduced', () => pm.expect(b.data.outstanding_amount).to.eql(600));",
                  "  pm.test('not fully paid', () => pm.expect(b.data.fully_paid).to.be.false);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payload\": {\n    \"invoice\": \"{{invoice}}\",\n    \"amount\": 400,\n    \"mode_of_payment\": \"Cash\"\n  }\n}" },
            "url": { "raw": "{{api}}.payments.record_payment", "host": ["{{api}}.payments.record_payment"] }
          }
        },
        {
          "name": "Record REMAINING payment (600)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().message;",
                  "if (b.success) pm.test('fully paid', () => pm.expect(b.data.fully_paid).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payload\": {\n    \"invoice\": \"{{invoice}}\",\n    \"amount\": 600,\n    \"mode_of_payment\": \"Cash\"\n  }\n}" },
            "url": { "raw": "{{api}}.payments.record_payment", "host": ["{{api}}.payments.record_payment"] }
          }
        },
        {
          "name": "Overpayment (expect rejection)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().message;",
                  "pm.test('overpayment refused', () => pm.expect(b.success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payload\": {\n    \"invoice\": \"{{invoice}}\",\n    \"amount\": 100\n  }\n}" },
            "url": { "raw": "{{api}}.payments.record_payment", "host": ["{{api}}.payments.record_payment"] }
          }
        },
        {
          "name": "Payment history",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": \"{{patient}}\"\n}" },
            "url": { "raw": "{{api}}.payments.payment_history", "host": ["{{api}}.payments.payment_history"] }
          }
        }
      ]
    },
    {
      "name": "8. Security probes",
      "description": "Run 'Login (Patient A)' first. Each of these MUST fail.",
      "item": [
        {
          "name": "Patient A reads Patient B (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "const b = pm.response.json().message;",
                  "pm.test('FORBIDDEN', () => pm.expect(b.error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": \"Test Patient B\"\n}" },
            "url": { "raw": "{{api}}.patients.get_patient", "host": ["{{api}}.patients.get_patient"] }
          }
        },
        {
          "name": "Patient A modifies Patient B (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": \"Test Patient B\",\n  \"payload\": { \"mobile\": \"+920000000000\" }\n}" },
            "url": { "raw": "{{api}}.patients.update_patient", "host": ["{{api}}.patients.update_patient"] }
          }
        },
        {
          "name": "Patient lists all patients (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{api}}.patients.list_patients", "host": ["{{api}}.patients.list_patients"] }
          }
        },
        {
          "name": "Patient records a payment (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payload\": { \"invoice\": \"{{invoice}}\", \"amount\": 1 }\n}" },
            "url": { "raw": "{{api}}.payments.record_payment", "host": ["{{api}}.payments.record_payment"] }
          }
        },
        {
          "name": "Reception reads clinical notes (expect clinical_access:false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().message;",
                  "if (b.success) {",
                  "  pm.test('clinical gated', () => pm.expect(b.data.clinical_access).to.be.false);",
                  "  pm.test('diagnosis absent', () => pm.expect(b.data).to.not.have.property('diagnosis'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"encounter\": \"{{encounter}}\"\n}" },
            "url": { "raw": "{{api}}.encounters.get_encounter", "host": ["{{api}}.encounters.get_encounter"] },
            "description": "Login as the Receptionist first."
          }
        },
        {
          "name": "Guest calls protected endpoint (expect 401/403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('denied', () => pm.expect([401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{api}}.patients.list_patients", "host": ["{{api}}.patients.list_patients"] },
            "description": "Clear cookies in Postman first so the request is unauthenticated."
          }
        }
      ]
    }
  ]
}
