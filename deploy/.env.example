# Clinic platform -- deployment settings.
#
# Copy these into Coolify's environment variables for the application. Do NOT
# commit a filled-in copy of this file; .gitignore already excludes .env.

# --- image -------------------------------------------------------------------
# Built and pushed by .github/workflows/build.yml. Pin a tag (the commit SHA)
# rather than :latest so a redeploy is reproducible and rollback is possible.
IMAGE_NAME=ghcr.io/muhammad14251425/health-care-app:latest

# --- site --------------------------------------------------------------------
# Must match the domain Coolify routes to this app, and the DNS A record.
SITE_NAME=api.health-care.phyntech.com

# --- database ----------------------------------------------------------------
# Generate with:  openssl rand -base64 32
# Needed again for `bench new-site`, so store it somewhere durable.
DB_ROOT_PASSWORD=

# --- site_config.json (applied during site creation, see RUNBOOK) ------------
# These are NOT read by docker-compose; they are the values you will set on the
# site itself. Listed here so every setting lives in one place.
#
# developer_mode         MUST be 0 in production. At 1 the console OTP provider
#                        is allowed, which prints login codes to the log.
# clinic_otp_provider    whatsapp | sms | console | null
# host_name              https://api.health-care.phyntech.com  (PDF rendering
#                        fails without it -- the renderer resolves asset URLs
#                        against this)
#
# Evolution API (WhatsApp OTP) -- copy from the project .env:
#   clinic_evolution_url
#   clinic_evolution_api_key
#   clinic_evolution_instance
