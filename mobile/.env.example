# Backend base URL.
#
# LEAVE THIS UNSET for normal development. The app reads the host Expo served
# the bundle from and calls port 8000 on that same address, so scanning the QR
# code from a phone automatically targets your machine's LAN IP -- no editing
# needed when the network changes.
#
# Set it only to point at a different backend, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.0.59:8000
#
# Fallbacks when Expo cannot report a LAN host:
#   Android emulator   http://10.0.2.2:8000   (10.0.2.2 = the host's loopback)
#   iOS simulator      http://localhost:8000
#
# EXPO_PUBLIC_API_URL=
